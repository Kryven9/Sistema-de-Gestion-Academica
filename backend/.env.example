
# Entorno de ejecucion
NODE_DEV=development

# Servidor
PORT=4000

# Base de datos MySQL (valores para docker-compose local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=sga_universitario

# Cadena completa usada por Prisma
DATABASE_URL="mysql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Autenticacion
JWT_SECRET=cambiar_este_valor_en_produccion
JWT_EXPIRATION=8h

# Hash de contrasenas
BCRYPT_SALT_ROUNDS=10
