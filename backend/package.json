{
  "name": "sga-backend",
  "version": "0.1.0",
  "type": "module",
  "description": "Sistema de Gestion Academica Universitaria - Backend",
  "main": "src/main/server.js",
  "scripts": {
    "dev": "node src/main/server.js",
    "dev:nodemon": "nodemon src/main/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prisma:generar": "prisma generate",
    "prisma:migrar": "prisma migrate dev",
    "prisma:desplegar": "prisma migrate deploy",
    "prisma:estudio": "prisma studio",
    "prisma:reiniciar": "prisma migrate reset --force",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
