{
  "name": "sga-backend",
  "version": "0.1.0",
  "type": "module",
  "description": "Sistema de Gestion Academica Universitaria - Backend",
  "main": "src/main/server.js",
  "scripts": {
    "dev": "node src/main/server.js",
    "dev:nodemon": "nodemon src/main/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prisma:generar": "prisma generate",
    "prisma:migrar": "prisma migrate dev",
    "prisma:desplegar": "prisma migrate deploy",
    "prisma:estudio": "prisma studio",
    "prisma:reiniciar": "prisma migrate reset --force",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  }
}
